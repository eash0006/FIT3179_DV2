{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "background": "#F8F9FA",
  "title": "Sources of Water intake",
  "width": 500,
  "height": 500,
  "data": [
    {
      "name": "tree",
      "url": "https://raw.githubusercontent.com/eash0006/FIT3179_DV2/refs/heads/main/sunburst.csv",
      "format": {"type": "csv", "parse": {"size": "number"}, "delimiter": ","},
      "transform": [
        {"type": "stratify", "key": "id", "parentKey": "parent"},
        {
          "type": "partition",
          "field": "size",
          "sort": {"field": "value"},
          "size": [{"signal": "2 * PI"}, {"signal": "width / 2"}],
          "as": ["a0", "r0", "a1", "r1", "depth", "children"]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": ["Plain Water", "Other Beverages"],
      "range": ["lightblue", "orange"]
    }
  ],

  "legends": [
  {
    "fill": "color",
    "orient": "bottom",
    "direction": "horizontal"
  }
],
  
  "marks": [
    {
      "type": "arc",
      "from": {"data": "tree"},
      "encode": {
        "enter": {
          "x": {"signal": "width / 2"},
          "y": {"signal": "height / 2"},
          "fill": {"scale": "color", "field": "colour"},
          "tooltip": {
            "signal":"datum.size ? datum.id + ': ' + datum.size + '%' : datum.id"
          }
        },
        "update": {
          "startAngle": {"field": "a0"},
          "endAngle": {"field": "a1"},
          "innerRadius": {"signal": "datum.depth == 0 ? 110 : datum.r0"},
          "outerRadius": {"field": "r1"},
          "stroke": {"value": "white"},
          "strokeWidth": {"value": 0.5}
        },
        "hover": {
          "stroke": {"value": "black"},
          "strokeWidth": {"value": 2}
        }
      }
      
    },

    {
  "type": "text",
  "from": {"data": "tree"},
  "encode": {
    "enter": {
      "x": {"signal": "width / 2"},
      "y": {"signal": "height / 2"},
      "align": {"value": "center"},
      "fontSize": {"value": 13}
    },
    "update": {
      "theta": {"signal": "(datum.a0 + datum.a1) / 2"},
      "radius": {"signal": "(datum.r0 + datum.r1) / 2"},
      "text": {"signal": "datum.depth > 0 ? datum.id + (datum.size ? ' ' + datum.size + '%' : '') : ''"}
    }
  }
}
  ],

  "config": {
  "font": "Avenir",
  "title": {"fontSize": 26},
  "axis": {
    "labelFontSize": 16,
    "titleFontSize": 18
  },
  "legend": {
    "labelFontSize": 16,
    "titleFontSize": 18
  }
}
}
