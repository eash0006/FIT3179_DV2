{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "https://raw.githubusercontent.com/eash0006/FIT3179_DV2/refs/heads/main/Connected%20dot%20plot.csv"
  },
  "background": "#F8F9FA",
  "title": "Proportion of adults aged 18 years and over, by usual consumption of grains and cereals",
  "width": 1200,
  "height": 500,
  "layer": [
    {
      "mark": {"type": "line", "color": "lightgrey"},
      "encoding": {
        "y": {
          "field": "Daily Consumption",
          "type": "ordinal",
          "sort": null,
          "scale": {"reverse": true}
        },
        "x": {"field": "Percentage", "type": "quantitative"},
        "detail": {"field": "Daily Consumption"}
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 100},
      "encoding": {
        "y": {
          "field": "Daily Consumption",
          "type": "ordinal",
          "sort": null,
          "scale": {"reverse": true}
        },
        "x": {"field": "Percentage", "type": "quantitative"},
        "color": {"field": "Gender", "type": "nominal", "legend": {"orient": "bottom"}}
      }
    }
  ],
    "config": {
  "font": "Avenir",
  "title": {"fontSize": 24},
  "axis": {
    "labelFontSize": 16,
    "titleFontSize": 18
  },
  "legend": {
    "labelFontSize": 16,
    "titleFontSize": 18
  }
}
}
