{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {"text": ["Australian's Meeting The Australian Dietary", "Recommendations"]},
  "background": "#F8F9FA",
  "width": 640,
  "height": 450,
  "data": {
    "url": "https://raw.githubusercontent.com/eash0006/FIT3179_DV2/refs/heads/main/Slope%20Graph.csv"
  },
  "mark": "line",
  "encoding": {
    "x": {"field": "Year", "type": "ordinal", "axis": {"labelAngle": 0}, "scale": {"padding": 0.05}},
    "y": {"field": "Percentage", "type": "quantitative", "title":"Percentage (%)"},
    "color": {
      "field": "Food Group",
      "legend": {"orient": "bottom", "columns": 2, "labelLimit": 650}
    }
  },
  "config": {
  "font": "Avenir",
  "title": {"fontSize": 24},
  "axis": {
    "labelFontSize": 16,
    "titleFontSize": 18
  },
  "legend": {
    "labelFontSize": 16,
    "titleFontSize": 18
  }
}
}
