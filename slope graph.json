{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Percentage of Australian's Meeting Australian Dietary Recommendations",
  "background": "#F8F9FA",
  "width": 750,
  "height": 500,
  "data": {
    "url": "https://raw.githubusercontent.com/eash0006/FIT3179_DV2/refs/heads/main/Slope%20Graph.csv"
  },
  "mark": "line",
  "encoding": {
    "x": {"field": "Year", "type": "ordinal", "axis": {"labelAngle": 0}, "scale": {"padding": 0.05}},
    "y": {"field": "Percentage", "type": "quantitative"},
    "color": {
      "field": "Food Group",
      "legend": {"orient": "bottom", "columns": 3, "labelLimit": 750}
    }
  },
  "config": {
  "font": "Avenir",
  "title": {"fontSize": 26},
  "axis": {
    "labelFontSize": 16,
    "titleFontSize": 18
  },
  "legend": {
    "labelFontSize": 16,
    "titleFontSize": 18
  }
}
}
