{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "autosize": {"type": "fit", "contains": "padding"},
  "height": 500,
  "title": {
    "text": "Health Search Interest by State and Territory",
    "fontSize": 22
  },
  "data": {
    "url": "https://raw.githubusercontent.com/eash0006/FIT3179_DV2/refs/heads/main/Health%20searches.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "point",
        "shape": "square",
        "filled": true,
        "size": 11500,
        "stroke": "white"
      },
      "encoding": {
        "x": {"field": "X", "type": "ordinal", "axis": null},
        "y": {"field": "Y", "type": "ordinal", "axis": null},
        "color": {
          "field": "Score",
          "type": "quantitative",
          "scale": {"scheme": "blues"}
        },
        "tooltip": [{"field": "State"}, {"field": "Score"}]
      }
    },
    {
      "mark": {"type": "text", "fontSize": 8.5, "color": "black"},
      "encoding": {
        "x": {"field": "X", "type": "ordinal"},
        "y": {"field": "Y", "type": "ordinal"},
        "text": {"field": "State"}
      }
    }
  ],
  "config": {}
}
