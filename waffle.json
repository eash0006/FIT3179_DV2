{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Exceeding Unsaturated Spread and Oil Recommendations",
  "background": "#F8F9FA",
  "width": 600,
  "height": 500,
  "data": {"sequence": {"start": 1, "stop": 101}},
  "transform": [
    {
      "calculate": "datum.data <= 51 ? 'Yes' : 'No'",
      "as": "Exceeded Recommendation"
    },
    {"calculate": "(datum.data-1)%10", "as": "x"},
    {"calculate": "floor((datum.data-1)/10)", "as": "y"}
  ],
  "mark": {"type": "square", "size": 500},
  "encoding": {
    "x": {"field": "x", "axis": null},
    "y": {"field": "y", "axis": null},
    "color": {
      "field": "Exceeded Recommendation",
      "scale": {"domain": ["Yes", "No"], "range": ["orange", "lightgrey"]},
       "legend": {"orient": "bottom"}
    }
  },
  "config": {
  "font": "Avenir",
  "view": {"stroke": null},
  "title": {"fontSize": 24},
  "axis": {
    "labelFontSize": 16,
    "titleFontSize": 18
  },
  "legend": {
    "labelFontSize": 16,
    "titleFontSize": 18
  }
}
}
