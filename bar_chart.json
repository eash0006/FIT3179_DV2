{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "https://raw.githubusercontent.com/eash0006/FIT3179_DV2/refs/heads/main/bar_chart.csv"
  },
  "title": "Contribution to Lean Meat & Alternatives Consumption",
  "background": "#F8F9FA",
  "width": 550,
  "height": 500,
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "Food Group",
      "type": "nominal",
      "axis": {"labelAngle": 330, "labelLimit": 500}
    },
    "y": {"field": "Contribution (%)", "type": "quantitative"},
    "color": {"field": "Food Group", "type": "nominal",  "legend": null, "scale": {
    "range": [
      "#4E79A7",
      "#F28E2B",
      "#76B7B2",
      "#EDC948",
      "#B07AA1",
      "#FF9DA7"
    ]}}},
  "config": {
  "font": "Avenir",
  "title": {"fontSize": 22},
  "axis": {
    "labelFontSize": 16,
    "titleFontSize": 18
  },
  "legend": {
    "labelFontSize": 16,
    "titleFontSize": 18
  }
}
}
