{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "https://raw.githubusercontent.com/eash0006/FIT3179_DV2/refs/heads/main/bar_chart.csv"
  },
  "background": "#F8F9FA",
  "width": 600,
  "height": 500,
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "Food Group",
      "type": "nominal",
      "axis": {"labelAngle": 330}
    },
    "y": {"field": "Contribution (%)", "type": "quantitative"}
  },
  "config": {
  "font": "Avenir",
  "title": {"fontSize": 26},
  "axis": {
    "labelFontSize": 16,
    "titleFontSize": 18
  },
  "legend": {
    "labelFontSize": 16,
    "titleFontSize": 18
  }
}
}
