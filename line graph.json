{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "https://raw.githubusercontent.com/eash0006/FIT3179_DV2/refs/heads/main/Line%20graph.csv"
  },
  "title": {"text": ["Australian's over 18 not meeting Fruit & Vegetable", "Recommendations"]},
  "background": "#F8F9FA",
  "width": 550,
  "height": 500,
  "mark": "line",
  "encoding": {
    "x": {"field": "Year", "type": "ordinal", "axis": {"labelAngle": 0}, "labelLimit": 100},
    "y": {"field": "Percentage (%)", "type": "quantitative"},
    "color": {"field": "Category"}
  },
  "config": {
    "font": "Avenir",
    "title": {"fontSize": 24},
    "axis": {"labelFontSize": 16, "titleFontSize": 18},
    "legend": {"labelFontSize": 16, "titleFontSize": 18, "orient": "bottom"}
  }
}
