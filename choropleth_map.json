{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text":"Percentage of Australian's Not Meeting Fruit & Vegetable Consumption Recommendations", "fontSize": 24},
  "width": 600,
  "height": 500,
  "projection": {"type": "mercator"},
  "data": {
    "url": "https://raw.githubusercontent.com/eash0006/FIT3179_DV2/refs/heads/main/STE_2016_AUST.json",
    "format": {"type": "topojson", "feature": "STE_2016_AUST"}
  },
  "transform": [
    {
      "lookup": "properties.STE_NAME16",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/eash0006/FIT3179_DV2/refs/heads/main/fruit%20%26%20veggie%20consumption.csv"
        },
        "key": "State",
        "fields": ["Percentage of state population (%)"]
      }
    }
  ],
  "mark": {"type": "geoshape"},
  "encoding": {
    "color": {
      "field": "Percentage of state population (%)",
      "type": "quantitative",
      "title": "% Not Meeting Recommendations",
      "scale": {"type": "log"}
    },
    "tooltip": [
      {"field": "properties.STE_NAME16", "title": "State"},
      {"field": "Percentage of state population (%)", "title": "Percentage (%)"}
    ]
  }
}
